{
	"name": "graphql-rss-parser",
	"version": "5.0.0",
	"private": true,
	"description": "A microservice that parses rss feeds and makes it available as grahpql schema",
	"type": "module",
	"exports": "./dist/index.js",
	"packageManager": "npm@12.2.1",
	"engines": {
		"node": ">=26.0.0"
	},
	"bin": {
		"graphql-rss-parser": "./cli.js"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"start": "./cli.js",
		"dev": "nodemon --ext ts,js,json,mjs -w src -w package-lock.json -w tsconfig ./cli.js",
		"test": "jest",
		"lint": "biome lint .",
		"lint:ci": "biome ci .",
		"format": "biome check --write .",
		"format:unsafe": "biome check --write --unsafe ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/relekang/graphql-rss-parser.git"
	},
	"files": [
		"dist",
		"cli.js",
		"license",
		"readme.md"
	],
	"author": "Rolf Erik Lekang",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/relekang/graphql-rss-parser/issues"
	},
	"homepage": "https://github.com/relekang/graphql-rss-parser#readme",
	"dependencies": {
		"@apollo/server": "^5.0.0",
		"@graphql-tools/schema": "^11.0.0",
		"@sentry/node": "^11.0.0",
		"axios": "^1.2.2",
		"cheerio": "^1.0.0-rc.10",
		"cmd-ts": "^0.15.0",
		"debug": "^4.2.0",
		"feedme": "^2.0.2",
		"feedparser": "^2.0.0",
		"graphql": "^16.11.0",
		"http-status-codes": "^2.2.0",
		"is-url": "^1.2.4",
		"normalize-url": "^10.0.0",
		"pino": "^10.0.0",
		"pino-pretty": "^13.0.0",
		"rss-parser": "^3.12.0",
		"rss-to-json": "github:relekang/rss-to-json#04b2c90",
		"update-notifier": "^7.0.0"
	},
	"overrides": {
		"rss-to-json": {
			"fast-xml-parser": "^5.11.2"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@swc/core": "^1.10.16",
		"@swc/jest": "^0.2.37",
		"@types/debug": "^4.1.7",
		"@types/feedparser": "2.2.8",
		"@types/fs-extra-promise": "^1.0.10",
		"@types/is-url": "^1.2.30",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.0.0",
		"fs-extra-promise": "^1.0.1",
		"jest": "^30.0.0",
		"nock": "^15.0.0",
		"nodemon": "^3.0.0",
		"typescript": "^7.0.0"
	}
}
